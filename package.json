{
  "name": "peapod-video",
  "version": "0.1.0",
  "private": true,
  "description": "Thẻ ảnh và video PeaPod dựng bằng Remotion. Được gọi từ worker PeaPod qua scripts/render.ts.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3100 --no-open",
    "typecheck": "tsc --noEmit",
    "render:card": "tsx scripts/render.ts card",
    "serve": "tsx --env-file=.env src/render-service.ts",
    "test": "vitest run",
    "manifest": "tsx scripts/manifest.ts",
    "spec:validate": "tsx scripts/spec-validate.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@remotion/animation-utils": "4.0.540",
    "@remotion/bundler": "4.0.540",
    "@remotion/captions": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/google-fonts": "4.0.540",
    "@remotion/install-whisper-cpp": "4.0.540",
    "@remotion/layout-utils": "4.0.540",
    "@remotion/light-leaks": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "@remotion/noise": "4.0.540",
    "@remotion/paths": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/rough-notation": "4.0.540",
    "@remotion/sfx": "4.0.540",
    "@remotion/shapes": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.540",
    "@types/node": "^20.12.14",
    "@types/react": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
